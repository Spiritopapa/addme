# ===========================================================
# Supabase credentials — copy this file to `.env` and fill in.
# Find your values in Supabase Dashboard → Project Settings → API
# ===========================================================

# Example: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=your-project-url

# The public "anon" key (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=your-anon-public-key